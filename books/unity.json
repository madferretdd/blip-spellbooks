{
  "spellbook": 1,
  "id": "unity",
  "name": "Unity",
  "version": "0.1.0",
  "license": "CC-BY-4.0",
  "authors": ["Blip starter set"],
  "tested_with": "Unity 6 (6000.0)",
  "language": "en",
  "about": "Game engine editor: scenes, GameObjects, components and C# scripts.",
  "app": { "exe": ["unity"], "title": [] },
  "landmarks": [
    { "name": "Hierarchy", "where": "left panel", "what": "every GameObject in the open scene" },
    { "name": "Inspector", "where": "right panel", "what": "components on the selected object" },
    { "name": "Project", "where": "bottom panel", "what": "your assets on disk" },
    { "name": "Console", "where": "tab next to Project at the bottom", "what": "logs, warnings and errors" },
    { "name": "Scene", "where": "middle, tab next to Game", "what": "edit view" },
    { "name": "Game", "where": "middle, tab next to Scene", "what": "what the camera sees" },
    { "name": "Add Component", "where": "bottom of the Inspector" },
    { "name": "Play", "where": "triangle button top centre" }
  ],
  "recipes": [
    { "id": "new-script", "asks": ["make a script", "create a c# script", "new script", "add code"], "checked": true,
      "steps": [ { "do": "Right-click in the Project panel" }, { "do": "Create, Scripting, MonoBehaviour Script", "click": "Create > Scripting > MonoBehaviour Script" },
                 { "do": "Name it before pressing Enter, so the class name matches the file" } ] },
    { "id": "add-component", "asks": ["add a component", "add a script to an object", "attach a script"], "checked": true,
      "steps": [ { "do": "Select the object in the Hierarchy" }, { "do": "Click Add Component at the bottom of the Inspector and type the name", "click": "Add Component" } ] },
    { "id": "rigidbody", "asks": ["add physics", "add a rigidbody", "make it fall", "add gravity"], "checked": true,
      "steps": [ { "do": "Select the object" }, { "do": "Add Component, then type Rigidbody", "click": "Add Component" }, { "do": "Make sure it has a Collider too" } ] },
    { "id": "empty", "asks": ["create an empty", "empty gameobject", "add an empty object"], "checked": true,
      "steps": [ { "do": "GameObject, Create Empty", "keys": "Ctrl+Shift+N", "click": "GameObject > Create Empty" } ] },
    { "id": "prefab", "asks": ["make a prefab", "create a prefab", "save as prefab"], "checked": true,
      "steps": [ { "do": "Drag the object from the Hierarchy into a folder in the Project panel" } ] },
    { "id": "build", "asks": ["build the game", "make a build", "export the game", "build settings", "build profiles"], "checked": true,
      "steps": [ { "do": "File, Build Profiles", "keys": "Ctrl+Shift+B", "click": "File > Build Profiles" }, { "do": "Pick the platform, check your scenes are in the list, then Build" } ] },
    { "id": "package-manager", "asks": ["install a package", "package manager", "add a package"], "checked": true,
      "steps": [ { "do": "Window, Package Manager", "click": "Window > Package Manager" } ] },
    { "id": "console", "asks": ["see errors", "open the console", "where are the logs"], "checked": true,
      "steps": [ { "do": "Window, General, Console", "keys": "Ctrl+Shift+C", "click": "Window > General > Console" } ] },
    { "id": "lighting", "asks": ["bake lighting", "generate lighting", "lightmaps"], "checked": true,
      "steps": [ { "do": "Window, Rendering, Lighting", "click": "Window > Rendering > Lighting" }, { "do": "Click Generate Lighting at the bottom", "click": "Generate Lighting" } ] },
    { "id": "material", "asks": ["make a material", "create a material", "change the colour"], "checked": true,
      "steps": [ { "do": "Right-click in the Project panel" }, { "do": "Create, Material", "click": "Create > Material" }, { "do": "Drag it onto the object in the Scene view" } ] },
    { "id": "import-package", "asks": ["import a unitypackage", "import a package file", "import custom package"], "checked": true,
      "steps": [ { "do": "Assets, Import Package, Custom Package", "click": "Assets > Import Package > Custom Package..." } ] },
    { "id": "frame", "asks": ["focus on object", "frame selected", "find my object", "zoom to object"], "checked": true,
      "steps": [ { "do": "Double-click it in the Hierarchy, or hover the Scene view and press F", "keys": "F" } ] },
    { "id": "play", "asks": ["play the game", "test the game", "start play mode"], "checked": true,
      "steps": [ { "do": "Press the Play triangle at the top, or Ctrl+P", "keys": "Ctrl+P" } ] },
    { "id": "ui-button", "asks": ["add a button", "make a ui button", "add ui"], "checked": false,
      "steps": [ { "do": "GameObject, UI, Button - TextMeshPro", "click": "GameObject > UI > Button - TextMeshPro" }, { "do": "Import TMP Essentials if Unity asks" } ] }
  ],
  "glossary": {
    "GameObject": "Anything in a scene. Its behaviour comes from components.",
    "Component": "A piece of behaviour or data on a GameObject (Transform, Rigidbody, your scripts).",
    "Prefab": "A saved, reusable GameObject. Edit the prefab and every copy updates.",
    "Play Mode": "Running the game in the editor. Changes made in Play Mode are lost when you stop."
  },
  "tips": [
    "Changes in Play Mode vanish when you stop. Tint Play Mode in Preferences, Colors so you notice.",
    "Name a script before pressing Enter: the class name has to match the file name.",
    "Rigidbody objects should move with forces or MovePosition in FixedUpdate, not by setting transform.",
    "Missing reference errors usually mean a field wasn't dragged in the Inspector.",
    "Prefab variants let you tweak one copy without breaking the original prefab."
  ]
}
